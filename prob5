public class Main {

    static int factorial(int n) {
        if(n == 0 || n == 1)
            return 1;
        return n * factorial(n - 1);
    }

    public static void main(String[] args) {
        System.out.println(factorial(5));
    }
}
public class Main {

    static int fib(int n) {
        if(n <= 1)
            return n;
        return fib(n - 1) + fib(n - 2);
    }

    public static void main(String[] args) {
        for(int i = 0; i < 10; i++)
            System.out.print(fib(i) + " ");
    }
}
