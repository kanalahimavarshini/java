public class Main {
    public static void main(String[] args) {
        int num = 1234;
        int rev = 0;

        while(num > 0) {
            rev = rev * 10 + num % 10;
            num /= 10;
        }

        System.out.println(rev);
    }
}
public class Main {
    public static void main(String[] args) {
        int num = 121, temp = num, rev = 0;

        while(temp > 0) {
            rev = rev * 10 + temp % 10;
            temp /= 10;
        }

        System.out.println(num == rev);
    }
}
