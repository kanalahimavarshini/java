public class Main {
    public static void main(String[] args) {
        int arr[] = {10, 50, 30, 90, 70};

        int first = Integer.MIN_VALUE;
        int second = Integer.MIN_VALUE;

        for(int num : arr) {
            if(num > first) {
                second = first;
                first = num;
            } else if(num > second && num != first) {
                second = num;
            }
        }

        System.out.println("Second Largest = " + second);
    }
}
