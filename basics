public class Main {
    public static void main(String[] args) {
        int n = 13;
        boolean prime = true;

        for(int i = 2; i <= n / 2; i++) {
            if(n % i == 0) {
                prime = false;
                break;
            }
        }

        if(prime)
            System.out.println("Prime");
        else
            System.out.println("Not Prime");
    }
}
public class Main {
    public static void main(String[] args) {
        int num = 1234, rev = 0;

        while(num != 0) {
            int digit = num % 10;
            rev = rev * 10 + digit;
            num /= 10;
        }

        System.out.println("Reversed Number = " + rev);
    }
}
public class Main {
    public static void main(String[] args) {
        int num = 121, original = num, rev = 0;

        while(num != 0) {
            int digit = num % 10;
            rev = rev * 10 + digit;
            num /= 10;
        }

        if(original == rev)
            System.out.println("Palindrome");
        else
            System.out.println("Not Palindrome");
    }
}
