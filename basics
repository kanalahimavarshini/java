public class Main {
    public static void main(String[] args) {
        int num = 1234, rev = 0;

        while(num != 0) {
            int digit = num % 10;
            rev = rev * 10 + digit;
            num /= 10;
        }

        System.out.println("Reversed Number = " + rev);
    }
}
public class Main {
    public static void main(String[] args) {
        int num = 121, original = num, rev = 0;

        while(num != 0) {
            int digit = num % 10;
            rev = rev * 10 + digit;
            num /= 10;
        }

        if(original == rev)
            System.out.println("Palindrome");
        else
            System.out.println("Not Palindrome");
    }
}
