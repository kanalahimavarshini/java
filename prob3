public class Main {
    static int factorial(int n) {
        int fact = 1;

        for(int i = 1; i <= n; i++)
            fact *= i;

        return fact;
    }

    public static void main(String[] args) {
        int num = 145, temp = num, sum = 0;

        while(temp > 0) {
            int digit = temp % 10;
            sum += factorial(digit);
            temp /= 10;
        }

        System.out.println(sum == num ? "Strong" : "Not Strong");
    }
}
