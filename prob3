public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40};
        int key = 30;

        for(int i = 0; i < arr.length; i++) {
            if(arr[i] == key) {
                System.out.println("Found at index " + i);
                return;
            }
        }

        System.out.println("Not Found");
    }
}
public class Main {
    public static void main(String[] args) {
        int[] arr = {10,20,30,40,50};
        int key = 40;
        int low = 0, high = arr.length - 1;

        while(low <= high) {
            int mid = (low + high) / 2;

            if(arr[mid] == key) {
                System.out.println(mid);
                return;
            } else if(arr[mid] < key) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        System.out.println("Not Found");
    }
}